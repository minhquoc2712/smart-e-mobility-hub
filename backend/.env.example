# ============================================================================
# Smart E-Mobility Hub — Backend environment
# Copy file này thành backend/.env rồi điền giá trị của máy bạn.
# KHÔNG commit file .env (đã có trong .gitignore). Chỉ commit file .env.example này.
# ============================================================================

# --- Server ---
PORT=4000
# Địa chỉ frontend được phép gọi API (Vite dev server)
CORS_ORIGIN=http://localhost:5173
# development: bật /auth/dev-login (đăng nhập nhanh không cần Google) trên máy cá nhân.
# Khi deploy: đặt production. Mọi giá trị khác development đều TẮT dev-login.
NODE_ENV=development

# --- Database (MySQL 8.0+) ---
# Tạo database trước: mysql -u root -p < database/schema.sql
#                     mysql -u root -p smart_emobility_hub < database/seed.sql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=smart_emobility_hub

# --- Auth: Google Sign-In + JWT (Task 3.1c) — BẮT BUỘC, thiếu thì server không khởi động ---
# OAuth Client ID loại "Web application" từ Google Cloud Console (APIs & Services -> Credentials).
# Phải trùng với VITE_GOOGLE_CLIENT_ID trong frontend/.env. KHÔNG cần Client secret.
GOOGLE_CLIENT_ID=
# Chuỗi bí mật để ký JWT. Mỗi máy/môi trường tự tạo, không chia sẻ, không commit.
# Tạo bằng: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Thời hạn phiên đăng nhập (vd: 1h, 8h, 1d). Xoá email khỏi OPERATOR_EMAILS chỉ có hiệu lực khi token cũ hết hạn.
JWT_EXPIRES_IN=8h

# --- Phân quyền ---
# Email được làm OPERATOR, cách nhau bằng dấu phẩy (không phân biệt hoa thường). Mọi email khác là USER.
OPERATOR_EMAILS=operator@hcmut.edu.vn

# --- A3 Telemetry Simulator (Task 3.1b) ---
# Khoá mà simulator phải gửi kèm khi gọi POST /api/v1/telemetry/ingest.
# Nên luôn đặt giá trị: để trống thì endpoint này mở cho bất kỳ ai.
SIMULATOR_API_KEY=
